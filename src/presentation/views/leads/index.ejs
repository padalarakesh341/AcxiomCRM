<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
  <div>
    <h3 class="fw-bold mb-1">Lead Management</h3>
    <p class="text-muted small mb-0">Capture, nurture, qualify, and convert prospective client opportunities.</p>
  </div>
  <div>
    <a href="/leads/new" class="btn btn-primary shadow-sm fw-semibold">
      <i class="bi bi-funnel-fill me-1"></i> Capture Lead
    </a>
  </div>
</div>

<!-- Search & Filter Card -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
  <div class="card-body p-3">
    <form action="/leads" method="GET" class="row g-2 align-items-center">
      <div class="col-md-4">
        <div class="input-group">
          <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
          <input type="text" name="search" class="form-control border-start-0 ps-0" placeholder="Search title, contact, company..." value="<%= search %>">
        </div>
      </div>
      <div class="col-md-3">
        <select name="status" class="form-select">
          <option value="">All Statuses</option>
          <option value="New" <%= status === 'New' ? 'selected' : '' %>>New</option>
          <option value="Contacted" <%= status === 'Contacted' ? 'selected' : '' %>>Contacted</option>
          <option value="Qualified" <%= status === 'Qualified' ? 'selected' : '' %>>Qualified</option>
          <option value="Unqualified" <%= status === 'Unqualified' ? 'selected' : '' %>>Unqualified</option>
          <option value="Converted" <%= status === 'Converted' ? 'selected' : '' %>>Converted</option>
          <option value="Lost" <%= status === 'Lost' ? 'selected' : '' %>>Lost</option>
        </select>
      </div>
      <div class="col-md-2">
        <select name="priority" class="form-select">
          <option value="">All Priorities</option>
          <option value="High" <%= priority === 'High' ? 'selected' : '' %>>High</option>
          <option value="Medium" <%= priority === 'Medium' ? 'selected' : '' %>>Medium</option>
          <option value="Low" <%= priority === 'Low' ? 'selected' : '' %>>Low</option>
        </select>
      </div>
      <div class="col-md-2">
        <button type="submit" class="btn btn-secondary w-100 fw-semibold">Filter</button>
      </div>
      <% if (search || status || priority) { %>
        <div class="col-md-1 text-end">
          <a href="/leads" class="btn btn-link text-muted p-0 small">Reset</a>
        </div>
      <% } %>
    </form>
  </div>
</div>

<!-- Leads Table -->
<div class="card border-0 shadow-sm rounded-3 overflow-hidden">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead>
        <tr>
          <th>Lead Title</th>
          <th>Contact Person</th>
          <th>Source</th>
          <th>Status</th>
          <th>Priority</th>
          <th>Assigned Executive</th>
          <th class="text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (leads.length === 0) { %>
          <tr>
            <td colspan="7" class="text-center py-5 text-muted">
              <i class="bi bi-funnel display-6 d-block mb-2 text-secondary opacity-50"></i>
              No lead records found.
            </td>
          </tr>
        <% } %>
        <% leads.forEach(l => { %>
          <tr>
            <td>
              <div class="fw-bold"><a href="/leads/<%= l.id %>" class="text-decoration-none text-dark"><%= l.title %></a></div>
              <% if (l.company) { %>
                <small class="text-muted"><i class="bi bi-building me-1"></i><%= l.company %></small>
              <% } %>
            </td>
            <td>
              <div class="fw-semibold"><%= l.contact_person %></div>
              <small class="text-muted"><%= l.email %> &bull; <%= l.phone %></small>
            </td>
            <td>
              <span class="badge bg-light text-dark border"><%= l.source %></span>
            </td>
            <td>
              <% if (l.status === 'New') { %>
                <span class="badge bg-primary-subtle text-primary border badge-status">New</span>
              <% } else if (l.status === 'Contacted') { %>
                <span class="badge bg-warning-subtle text-warning border badge-status">Contacted</span>
              <% } else if (l.status === 'Qualified') { %>
                <span class="badge bg-info-subtle text-info border badge-status">Qualified</span>
              <% } else if (l.status === 'Converted') { %>
                <span class="badge bg-success-subtle text-success border badge-status">Converted</span>
              <% } else if (l.status === 'Lost') { %>
                <span class="badge bg-danger-subtle text-danger border badge-status">Lost</span>
              <% } else { %>
                <span class="badge bg-secondary-subtle text-secondary border badge-status"><%= l.status %></span>
              <% } %>
            </td>
            <td>
              <% if (l.priority === 'High') { %>
                <span class="badge bg-danger">High</span>
              <% } else if (l.priority === 'Medium') { %>
                <span class="badge bg-warning text-dark">Medium</span>
              <% } else { %>
                <span class="badge bg-light text-secondary border">Low</span>
              <% } %>
            </td>
            <td>
              <span class="small fw-semibold"><%= l.assigned_to_name || 'Unassigned' %></span>
            </td>
            <td class="text-end">
              <div class="btn-group btn-group-sm">
                <a href="/leads/<%= l.id %>" class="btn btn-outline-secondary" title="View Details">
                  <i class="bi bi-eye"></i>
                </a>
                <% if (l.status !== 'Converted') { %>
                  <a href="/leads/<%= l.id %>/edit" class="btn btn-outline-secondary" title="Edit">
                    <i class="bi bi-pencil"></i>
                  </a>
                <% } %>
                <% const role = currentUser.role_name || currentUser.role; %>
                <% if (role === 'Admin' || role === 'Manager') { %>
                  <form action="/leads/<%= l.id %>/delete" method="POST" class="d-inline confirm-action" data-confirm-message="Are you sure you want to delete this lead?">
                    <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
                    <button type="submit" class="btn btn-outline-danger" title="Delete">
                      <i class="bi bi-trash"></i>
                    </button>
                  </form>
                <% } %>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <!-- Pagination Footer -->
  <% if (pagination.totalPages > 1) { %>
    <div class="card-footer bg-white border-top py-3 d-flex justify-content-between align-items-center">
      <span class="small text-muted">Showing <%= leads.length %> of <%= pagination.total %> leads</span>
      <nav>
        <ul class="pagination pagination-sm mb-0">
          <li class="page-item <%= pagination.page <= 1 ? 'disabled' : '' %>">
            <a class="page-link" href="/leads?page=<%= pagination.page - 1 %>&search=<%= search %>&status=<%= status %>&priority=<%= priority %>">Previous</a>
          </li>
          <% for(let p = 1; p <= pagination.totalPages; p++) { %>
            <li class="page-item <%= pagination.page === p ? 'active' : '' %>">
              <a class="page-link" href="/leads?page=<%= p %>&search=<%= search %>&status=<%= status %>&priority=<%= priority %>"><%= p %></a>
            </li>
          <% } %>
          <li class="page-item <%= pagination.page >= pagination.totalPages ? 'disabled' : '' %>">
            <a class="page-link" href="/leads?page=<%= pagination.page + 1 %>&search=<%= search %>&status=<%= status %>&priority=<%= priority %>">Next</a>
          </li>
        </ul>
      </nav>
    </div>
  <% } %>
</div>
