<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
  <div>
    <h3 class="fw-bold mb-1">Customer Management</h3>
    <p class="text-muted small mb-0">Manage customer accounts, contacts, and communication history.</p>
  </div>
  <div>
    <a href="/customers/new" class="btn btn-primary shadow-sm fw-semibold">
      <i class="bi bi-person-plus-fill me-1"></i> New Customer
    </a>
  </div>
</div>

<!-- Search & Filter Card -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
  <div class="card-body p-3">
    <form action="/customers" method="GET" class="row g-2 align-items-center">
      <div class="col-md-6 col-lg-5">
        <div class="input-group">
          <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
          <input type="text" name="search" class="form-control border-start-0 ps-0" placeholder="Search by name, company, email, phone..." value="<%= search %>">
        </div>
      </div>
      <div class="col-md-4 col-lg-3">
        <select name="status" class="form-select">
          <option value="">All Statuses</option>
          <option value="Active" <%= status === 'Active' ? 'selected' : '' %>>Active</option>
          <option value="Inactive" <%= status === 'Inactive' ? 'selected' : '' %>>Inactive</option>
          <option value="Lead" <%= status === 'Lead' ? 'selected' : '' %>>Lead</option>
        </select>
      </div>
      <div class="col-md-2 col-lg-2">
        <button type="submit" class="btn btn-secondary w-100 fw-semibold">Filter</button>
      </div>
      <% if (search || status) { %>
        <div class="col-md-12 col-lg-2 text-lg-end">
          <a href="/customers" class="btn btn-link text-muted p-0 small">Clear Filters</a>
        </div>
      <% } %>
    </form>
  </div>
</div>

<!-- Customer Table Card -->
<div class="card border-0 shadow-sm rounded-3 overflow-hidden">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead>
        <tr>
          <th>Customer</th>
          <th>Contact</th>
          <th>Status</th>
          <th>Assigned Executive</th>
          <th>Created</th>
          <th class="text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (customers.length === 0) { %>
          <tr>
            <td colspan="6" class="text-center py-5 text-muted">
              <i class="bi bi-people display-6 d-block mb-2 text-secondary opacity-50"></i>
              No customer records found.
            </td>
          </tr>
        <% } %>
        <% customers.forEach(c => { %>
          <tr>
            <td>
              <div class="fw-bold text-dark"><a href="/customers/<%= c.id %>" class="text-decoration-none text-dark"><%= c.name %></a></div>
              <% if (c.company) { %>
                <small class="text-muted"><i class="bi bi-building me-1"></i><%= c.company %></small>
              <% } %>
            </td>
            <td>
              <div class="small"><i class="bi bi-envelope me-1 text-muted"></i><%= c.email %></div>
              <div class="small text-muted"><i class="bi bi-telephone me-1"></i><%= c.phone %></div>
            </td>
            <td>
              <% if (c.status === 'Active') { %>
                <span class="badge bg-success-subtle text-success border border-success-subtle badge-status">Active</span>
              <% } else if (c.status === 'Inactive') { %>
                <span class="badge bg-secondary-subtle text-secondary border badge-status">Inactive</span>
              <% } else { %>
                <span class="badge bg-info-subtle text-info border badge-status">Lead</span>
              <% } %>
            </td>
            <td>
              <span class="small fw-semibold"><%= c.assigned_to_name || 'Unassigned' %></span>
            </td>
            <td class="small text-muted">
              <%= c.created_at ? c.created_at.split(' ')[0] : '' %>
            </td>
            <td class="text-end">
              <div class="btn-group btn-group-sm">
                <a href="/customers/<%= c.id %>" class="btn btn-outline-secondary" title="View Details">
                  <i class="bi bi-eye"></i>
                </a>
                <a href="/customers/<%= c.id %>/edit" class="btn btn-outline-secondary" title="Edit">
                  <i class="bi bi-pencil"></i>
                </a>
                <% const role = currentUser.role_name || currentUser.role; %>
                <% if (role === 'Admin' || role === 'Manager') { %>
                  <form action="/customers/<%= c.id %>/delete" method="POST" class="d-inline confirm-action" data-confirm-message="Are you sure you want to delete this customer? All associated data will be removed.">
                    <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
                    <button type="submit" class="btn btn-outline-danger" title="Delete">
                      <i class="bi bi-trash"></i>
                    </button>
                  </form>
                <% } %>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <!-- Pagination Footer -->
  <% if (pagination.totalPages > 1) { %>
    <div class="card-footer bg-white border-top py-3 d-flex justify-content-between align-items-center">
      <span class="small text-muted">Showing <%= customers.length %> of <%= pagination.total %> customers</span>
      <nav>
        <ul class="pagination pagination-sm mb-0">
          <li class="page-item <%= pagination.page <= 1 ? 'disabled' : '' %>">
            <a class="page-link" href="/customers?page=<%= pagination.page - 1 %>&search=<%= search %>&status=<%= status %>">Previous</a>
          </li>
          <% for(let p = 1; p <= pagination.totalPages; p++) { %>
            <li class="page-item <%= pagination.page === p ? 'active' : '' %>">
              <a class="page-link" href="/customers?page=<%= p %>&search=<%= search %>&status=<%= status %>"><%= p %></a>
            </li>
          <% } %>
          <li class="page-item <%= pagination.page >= pagination.totalPages ? 'disabled' : '' %>">
            <a class="page-link" href="/customers?page=<%= pagination.page + 1 %>&search=<%= search %>&status=<%= status %>">Next</a>
          </li>
        </ul>
      </nav>
    </div>
  <% } %>
</div>
