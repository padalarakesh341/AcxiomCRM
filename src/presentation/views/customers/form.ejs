<div class="row justify-content-center">
  <div class="col-lg-8">
    <div class="card border-0 shadow-sm rounded-3">
      <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <h5 class="card-title mb-0 fw-bold">
          <i class="bi bi-<%= isEdit ? 'pencil-square' : 'person-plus-fill' %> me-2 text-primary"></i>
          <%= isEdit ? `Edit Customer - ${customer.name}` : 'Create New Customer' %>
        </h5>
        <a href="/customers" class="btn btn-sm btn-outline-secondary">Cancel</a>
      </div>
      <div class="card-body p-4">
        <form action="<%= isEdit ? `/customers/${customer.id}/edit` : '/customers' %>" method="POST" class="needs-validation" novalidate>
          <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">

          <div class="row g-3 mb-3">
            <div class="col-md-6">
              <label class="form-label small fw-semibold">Customer / Account Name <span class="text-danger">*</span></label>
              <input type="text" name="name" class="form-control" placeholder="e.g. Acme Corporation" value="<%= customer.name || '' %>" required>
              <div class="invalid-feedback">Name is required.</div>
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-semibold">Company / Organization</label>
              <input type="text" name="company" class="form-control" placeholder="e.g. Acme Industries Ltd" value="<%= customer.company || '' %>">
            </div>
          </div>

          <div class="row g-3 mb-3">
            <div class="col-md-6">
              <label class="form-label small fw-semibold">Email Address <span class="text-danger">*</span></label>
              <input type="email" name="email" class="form-control" placeholder="e.g. procurement@acme.com" value="<%= customer.email || '' %>" required>
              <div class="invalid-feedback">A valid email is required.</div>
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-semibold">Phone Number <span class="text-danger">*</span></label>
              <input type="text" name="phone" class="form-control" placeholder="e.g. +1-555-0199" value="<%= customer.phone || '' %>" required>
              <div class="invalid-feedback">Valid phone number is required.</div>
            </div>
          </div>

          <div class="row g-3 mb-3">
            <div class="col-md-6">
              <label class="form-label small fw-semibold">Status</label>
              <select name="status" class="form-select">
                <option value="Active" <%= customer.status === 'Active' ? 'selected' : '' %>>Active</option>
                <option value="Inactive" <%= customer.status === 'Inactive' ? 'selected' : '' %>>Inactive</option>
                <option value="Lead" <%= customer.status === 'Lead' ? 'selected' : '' %>>Lead</option>
              </select>
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-semibold">Assigned Sales Executive</label>
              <% const userRole = currentUser.role_name || currentUser.role; %>
              <% if (userRole === 'Sales Executive') { %>
                <input type="text" class="form-control bg-light" value="<%= currentUser.full_name %>" readonly>
                <input type="hidden" name="assignedUserId" value="<%= currentUser.id %>">
              <% } else { %>
                <select name="assignedUserId" class="form-select">
                  <option value="">-- Unassigned --</option>
                  <% executives.forEach(e => { %>
                    <option value="<%= e.id %>" <%= customer.assigned_user_id === e.id ? 'selected' : '' %>>
                      <%= e.full_name %> (<%= e.role_name %>)
                    </option>
                  <% }) %>
                </select>
              <% } %>
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label small fw-semibold">Billing / Business Address</label>
            <input type="text" name="address" class="form-control" placeholder="e.g. 100 Main St, Suite 200, City, State" value="<%= customer.address || '' %>">
          </div>

          <div class="mb-4">
            <label class="form-label small fw-semibold">Notes & Background</label>
            <textarea name="notes" class="form-control" rows="3" placeholder="Enter relevant customer context or deal history..."><%= customer.notes || '' %></textarea>
          </div>

          <div class="d-flex justify-content-end gap-2">
            <a href="/customers" class="btn btn-light border px-4">Cancel</a>
            <button type="submit" class="btn btn-primary px-4 fw-semibold shadow-sm">
              <i class="bi bi-check-lg me-1"></i> <%= isEdit ? 'Save Changes' : 'Create Customer' %>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
