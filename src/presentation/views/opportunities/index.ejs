<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
  <div>
    <h3 class="fw-bold mb-1">Opportunity Pipeline</h3>
    <p class="text-muted small mb-0">Track active sales pipeline, probabilities, stages, and weighted forecast.</p>
  </div>
  <div class="d-flex gap-2">
    <a href="/opportunities/kanban" class="btn btn-outline-secondary shadow-sm">
      <i class="bi bi-kanban me-1"></i> Kanban Board
    </a>
    <a href="/opportunities/new" class="btn btn-primary shadow-sm fw-semibold">
      <i class="bi bi-plus-lg me-1"></i> New Opportunity
    </a>
  </div>
</div>

<!-- Search & Filter Card -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
  <div class="card-body p-3">
    <form action="/opportunities" method="GET" class="row g-2 align-items-center">
      <div class="col-md-5">
        <div class="input-group">
          <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
          <input type="text" name="search" class="form-control border-start-0 ps-0" placeholder="Search opportunity or customer..." value="<%= search %>">
        </div>
      </div>
      <div class="col-md-4">
        <select name="stage" class="form-select">
          <option value="">All Pipeline Stages</option>
          <option value="Qualification" <%= stage === 'Qualification' ? 'selected' : '' %>>Qualification</option>
          <option value="Proposal" <%= stage === 'Proposal' ? 'selected' : '' %>>Proposal</option>
          <option value="Negotiation" <%= stage === 'Negotiation' ? 'selected' : '' %>>Negotiation</option>
          <option value="Won" <%= stage === 'Won' ? 'selected' : '' %>>Won</option>
          <option value="Lost" <%= stage === 'Lost' ? 'selected' : '' %>>Lost</option>
        </select>
      </div>
      <div class="col-md-2">
        <button type="submit" class="btn btn-secondary w-100 fw-semibold">Filter</button>
      </div>
      <% if (search || stage) { %>
        <div class="col-md-1 text-end">
          <a href="/opportunities" class="btn btn-link text-muted p-0 small">Reset</a>
        </div>
      <% } %>
    </form>
  </div>
</div>

<!-- Opportunities Table -->
<div class="card border-0 shadow-sm rounded-3 overflow-hidden">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead>
        <tr>
          <th>Opportunity</th>
          <th>Customer</th>
          <th>Stage</th>
          <th>Amount ($)</th>
          <th>Prob (%)</th>
          <th>Weighted ($)</th>
          <th>Expected Close</th>
          <th>Owner</th>
          <th class="text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (opportunities.length === 0) { %>
          <tr>
            <td colspan="9" class="text-center py-5 text-muted">
              <i class="bi bi-trophy display-6 d-block mb-2 text-secondary opacity-50"></i>
              No opportunities found.
            </td>
          </tr>
        <% } %>
        <% opportunities.forEach(opp => { %>
          <tr>
            <td>
              <div class="fw-bold"><a href="/opportunities/<%= opp.id %>/edit" class="text-decoration-none text-dark"><%= opp.name %></a></div>
            </td>
            <td>
              <a href="/customers/<%= opp.customer_id %>" class="small text-decoration-none"><%= opp.customer_name %></a>
            </td>
            <td>
              <% if (opp.stage === 'Won') { %>
                <span class="badge bg-success-subtle text-success border badge-status">Won</span>
              <% } else if (opp.stage === 'Lost') { %>
                <span class="badge bg-danger-subtle text-danger border badge-status">Lost</span>
              <% } else { %>
                <span class="badge bg-primary-subtle text-primary border badge-status"><%= opp.stage %></span>
              <% } %>
            </td>
            <td class="fw-semibold">
              $<%= Number(opp.amount).toLocaleString('en-US', { minimumFractionDigits: 2 }) %>
            </td>
            <td>
              <div class="d-flex align-items-center gap-1">
                <span><%= opp.probability %>%</span>
                <div class="progress flex-grow-1" style="height: 5px; width: 45px;">
                  <div class="progress-bar bg-primary" role="progressbar" style="width: <%= opp.probability %>%"></div>
                </div>
              </div>
            </td>
            <td class="fw-bold text-success">
              $<%= Number(opp.weighted_amount).toLocaleString('en-US', { minimumFractionDigits: 2 }) %>
            </td>
            <td class="small text-muted">
              <%= opp.expected_close_date %>
            </td>
            <td>
              <span class="small fw-semibold"><%= opp.owner_name %></span>
            </td>
            <td class="text-end">
              <div class="btn-group btn-group-sm">
                <a href="/opportunities/<%= opp.id %>/edit" class="btn btn-outline-secondary" title="Edit">
                  <i class="bi bi-pencil"></i>
                </a>
                <% const role = currentUser.role_name || currentUser.role; %>
                <% if (role === 'Admin' || role === 'Manager') { %>
                  <form action="/opportunities/<%= opp.id %>/delete" method="POST" class="d-inline confirm-action" data-confirm-message="Are you sure you want to delete this opportunity?">
                    <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
                    <button type="submit" class="btn btn-outline-danger" title="Delete">
                      <i class="bi bi-trash"></i>
                    </button>
                  </form>
                <% } %>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <!-- Pagination Footer -->
  <% if (pagination.totalPages > 1) { %>
    <div class="card-footer bg-white border-top py-3 d-flex justify-content-between align-items-center">
      <span class="small text-muted">Showing <%= opportunities.length %> of <%= pagination.total %> opportunities</span>
      <nav>
        <ul class="pagination pagination-sm mb-0">
          <li class="page-item <%= pagination.page <= 1 ? 'disabled' : '' %>">
            <a class="page-link" href="/opportunities?page=<%= pagination.page - 1 %>&search=<%= search %>&stage=<%= stage %>">Previous</a>
          </li>
          <% for(let p = 1; p <= pagination.totalPages; p++) { %>
            <li class="page-item <%= pagination.page === p ? 'active' : '' %>">
              <a class="page-link" href="/opportunities?page=<%= p %>&search=<%= search %>&stage=<%= stage %>"><%= p %></a>
            </li>
          <% } %>
          <li class="page-item <%= pagination.page >= pagination.totalPages ? 'disabled' : '' %>">
            <a class="page-link" href="/opportunities?page=<%= pagination.page + 1 %>&search=<%= search %>&stage=<%= stage %>">Next</a>
          </li>
        </ul>
      </nav>
    </div>
  <% } %>
</div>
