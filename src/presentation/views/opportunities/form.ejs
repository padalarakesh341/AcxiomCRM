<div class="row justify-content-center">
  <div class="col-lg-8">
    <div class="card border-0 shadow-sm rounded-3">
      <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <h5 class="card-title mb-0 fw-bold">
          <i class="bi bi-<%= isEdit ? 'pencil-square' : 'trophy-fill' %> me-2 text-primary"></i>
          <%= isEdit ? `Edit Opportunity - ${opportunity.name}` : 'Create New Opportunity' %>
        </h5>
        <a href="/opportunities" class="btn btn-sm btn-outline-secondary">Cancel</a>
      </div>
      <div class="card-body p-4">
        <form action="<%= isEdit ? `/opportunities/${opportunity.id}/edit` : '/opportunities' %>" method="POST" class="needs-validation" novalidate>
          <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">

          <div class="mb-3">
            <label class="form-label small fw-semibold">Opportunity Name <span class="text-danger">*</span></label>
            <input type="text" name="name" class="form-control" placeholder="e.g. 500 Enterprise SaaS Licenses" value="<%= opportunity.name || '' %>" required>
            <div class="invalid-feedback">Opportunity name is required.</div>
          </div>

          <div class="row g-3 mb-3">
            <div class="col-md-6">
              <label class="form-label small fw-semibold">Customer Account <span class="text-danger">*</span></label>
              <select name="customerId" class="form-select" required>
                <option value="">-- Select Customer --</option>
                <% customers.forEach(c => { %>
                  <option value="<%= c.id %>" <%= (opportunity.customer_id === c.id || opportunity.customerId === c.id) ? 'selected' : '' %>>
                    <%= c.name %> <%= c.company ? `(${c.company})` : '' %>
                  </option>
                <% }) %>
              </select>
              <div class="invalid-feedback">Customer is required.</div>
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-semibold">Opportunity Owner</label>
              <% const userRole = currentUser.role_name || currentUser.role; %>
              <% if (userRole === 'Sales Executive') { %>
                <input type="text" class="form-control bg-light" value="<%= currentUser.full_name %>" readonly>
                <input type="hidden" name="ownerUserId" value="<%= currentUser.id %>">
              <% } else { %>
                <select name="ownerUserId" class="form-select">
                  <% executives.forEach(e => { %>
                    <option value="<%= e.id %>" <%= (opportunity.owner_user_id === e.id || (!opportunity.owner_user_id && currentUser.id === e.id)) ? 'selected' : '' %>>
                      <%= e.full_name %> (<%= e.role_name %>)
                    </option>
                  <% }) %>
                </select>
              <% } %>
            </div>
          </div>

          <div class="row g-3 mb-3">
            <div class="col-md-4">
              <label class="form-label small fw-semibold">Pipeline Stage</label>
              <select name="stage" class="form-select">
                <option value="Qualification" <%= opportunity.stage === 'Qualification' ? 'selected' : '' %>>Qualification</option>
                <option value="Proposal" <%= opportunity.stage === 'Proposal' ? 'selected' : '' %>>Proposal</option>
                <option value="Negotiation" <%= opportunity.stage === 'Negotiation' ? 'selected' : '' %>>Negotiation</option>
                <option value="Won" <%= opportunity.stage === 'Won' ? 'selected' : '' %>>Won</option>
                <option value="Lost" <%= opportunity.stage === 'Lost' ? 'selected' : '' %>>Lost</option>
              </select>
            </div>
            <div class="col-md-4">
              <label class="form-label small fw-semibold">Amount ($) <span class="text-danger">*</span></label>
              <input type="number" step="0.01" min="1" name="amount" class="form-control" placeholder="e.g. 50000.00" value="<%= opportunity.amount || '' %>" required>
              <div class="invalid-feedback">Amount must be greater than zero.</div>
            </div>
            <div class="col-md-4">
              <label class="form-label small fw-semibold">Probability (%) <span class="text-danger">*</span></label>
              <input type="number" min="0" max="100" name="probability" class="form-control" placeholder="0-100" value="<%= opportunity.probability !== undefined ? opportunity.probability : 50 %>" required>
              <div class="invalid-feedback">Probability must be 0 - 100.</div>
            </div>
          </div>

          <div class="row g-3 mb-3">
            <div class="col-md-6">
              <label class="form-label small fw-semibold">Expected Close Date <span class="text-danger">*</span></label>
              <% const minDate = new Date().toISOString().split('T')[0]; %>
              <input type="date" name="expectedCloseDate" class="form-control" value="<%= opportunity.expected_close_date || '' %>" required>
              <div class="invalid-feedback">Expected close date is required.</div>
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-semibold">Lead / Opportunity Source</label>
              <input type="text" name="source" class="form-control" placeholder="e.g. Direct, Website, Referral" value="<%= opportunity.source || 'Direct' %>">
            </div>
          </div>

          <div class="mb-4">
            <label class="form-label small fw-semibold">Deal Notes & Strategic Context</label>
            <textarea name="notes" class="form-control" rows="3" placeholder="Key decision makers, competition, required deliverables..."><%= opportunity.notes || '' %></textarea>
          </div>

          <div class="d-flex justify-content-end gap-2">
            <a href="/opportunities" class="btn btn-light border px-4">Cancel</a>
            <button type="submit" class="btn btn-primary px-4 fw-semibold shadow-sm">
              <i class="bi bi-check-lg me-1"></i> <%= isEdit ? 'Save Changes' : 'Create Opportunity' %>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
