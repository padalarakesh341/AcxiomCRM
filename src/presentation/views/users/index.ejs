<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
  <div>
    <h3 class="fw-bold mb-1">User & Role Administration</h3>
    <p class="text-muted small mb-0">Manage system users, access credentials, role assignments, and security status.</p>
  </div>
  <div>
    <a href="/users/new" class="btn btn-primary shadow-sm fw-semibold">
      <i class="bi bi-person-plus-fill me-1"></i> Create User
    </a>
  </div>
</div>

<!-- Search & Filter Card -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
  <div class="card-body p-3">
    <form action="/users" method="GET" class="row g-2 align-items-center">
      <div class="col-md-5">
        <div class="input-group">
          <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
          <input type="text" name="search" class="form-control border-start-0 ps-0" placeholder="Search name, username, email..." value="<%= search %>">
        </div>
      </div>
      <div class="col-md-3">
        <select name="roleId" class="form-select">
          <option value="">All Roles</option>
          <% roles.forEach(r => { %>
            <option value="<%= r.id %>" <%= String(roleId) === String(r.id) ? 'selected' : '' %>><%= r.name %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-2">
        <select name="isActive" class="form-select">
          <option value="">All Statuses</option>
          <option value="1" <%= isActive === '1' ? 'selected' : '' %>>Active</option>
          <option value="0" <%= isActive === '0' ? 'selected' : '' %>>Inactive</option>
        </select>
      </div>
      <div class="col-md-2">
        <button type="submit" class="btn btn-secondary w-100 fw-semibold">Filter</button>
      </div>
    </form>
  </div>
</div>

<!-- Users Table -->
<div class="card border-0 shadow-sm rounded-3 overflow-hidden">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead>
        <tr>
          <th>User</th>
          <th>Role</th>
          <th>Status</th>
          <th>Lockout Status</th>
          <th>Last Login</th>
          <th class="text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (users.length === 0) { %>
          <tr><td colspan="6" class="text-center py-4 text-muted">No users found.</td></tr>
        <% } %>
        <% const now = new Date(); %>
        <% users.forEach(u => { %>
          <% const isLocked = u.locked_until && new Date(u.locked_until) > now; %>
          <tr>
            <td>
              <div class="fw-bold"><%= u.full_name %></div>
              <small class="text-muted">@<%= u.username %> &bull; <%= u.email %></small>
            </td>
            <td>
              <span class="badge bg-primary-subtle text-primary border"><%= u.role_name %></span>
            </td>
            <td>
              <% if (u.is_active) { %>
                <span class="badge bg-success-subtle text-success border">Active</span>
              <% } else { %>
                <span class="badge bg-secondary-subtle text-secondary border">Inactive</span>
              <% } %>
            </td>
            <td>
              <% if (isLocked) { %>
                <span class="badge bg-danger text-white mb-1 d-block" style="width: fit-content;">Locked (5 fails)</span>
                <form action="/users/<%= u.id %>/unlock" method="POST" class="d-inline m-0">
                  <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
                  <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2 small">Unlock</button>
                </form>
              <% } else { %>
                <span class="text-success small"><i class="bi bi-shield-check me-1"></i>Normal</span>
              <% } %>
            </td>
            <td class="small text-muted">
              <%= u.last_login_at ? u.last_login_at.split(' ')[0] : 'Never' %>
            </td>
            <td class="text-end">
              <div class="btn-group btn-group-sm">
                <a href="/users/<%= u.id %>/edit" class="btn btn-outline-secondary" title="Edit">
                  <i class="bi bi-pencil"></i>
                </a>
                <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#resetPasswordModal<%= u.id %>" title="Reset Password">
                  <i class="bi bi-key"></i>
                </button>
                <% if (u.id !== currentUser.id) { %>
                  <form action="/users/<%= u.id %>/toggle-status" method="POST" class="d-inline">
                    <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
                    <input type="hidden" name="isActive" value="<%= u.is_active ? '0' : '1' %>">
                    <button type="submit" class="btn btn-outline-<%= u.is_active ? 'warning' : 'success' %>" title="<%= u.is_active ? 'Deactivate' : 'Activate' %>">
                      <i class="bi bi-power"></i>
                    </button>
                  </form>
                <% } %>
              </div>

              <!-- Admin Reset Password Modal -->
              <div class="modal fade text-start" id="resetPasswordModal<%= u.id %>" tabindex="-1">
                <div class="modal-dialog">
                  <div class="modal-content">
                    <form action="/users/<%= u.id %>/reset-password" method="POST">
                      <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
                      <div class="modal-header">
                        <h6 class="modal-title fw-bold">Reset Password for <%= u.username %></h6>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                      </div>
                      <div class="modal-body">
                        <p class="small text-muted">The new password must conform to the security policy (8+ chars, upper, lower, number, special char).</p>
                        <div class="mb-3">
                          <label class="form-label small fw-semibold">New Password</label>
                          <input type="password" name="newPassword" class="form-control" placeholder="Enter new compliant password" required>
                        </div>
                      </div>
                      <div class="modal-footer">
                        <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Update Password</button>
                      </div>
                    </form>
                  </div>
                </div>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
