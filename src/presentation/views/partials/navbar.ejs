<nav class="navbar navbar-expand-lg top-navbar">
  <div class="container-fluid p-0">
    <!-- Breadcrumbs / Page Title -->
    <div class="d-flex align-items-center">
      <span class="fs-5 fw-bold text-dark"><%= locals.title || 'AcxiomCRM' %></span>
    </div>

    <!-- Right Controls -->
    <div class="d-flex align-items-center ms-auto gap-3">
      <!-- Quick API Docs Link -->
      <a href="/api/docs" target="_blank" class="btn btn-sm btn-outline-secondary d-none d-md-inline-flex align-items-center gap-1" title="Open API Documentation">
        <i class="bi bi-journal-code"></i> API Docs
      </a>

      <!-- User Menu Dropdown -->
      <% if (locals.currentUser) { %>
        <div class="dropdown">
          <button class="btn btn-light dropdown-toggle d-flex align-items-center gap-2 border py-1 px-3 rounded-pill" type="button" id="userMenuBtn" data-bs-toggle="dropdown" aria-expanded="false">
            <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center" style="width: 28px; height: 28px; font-size: 0.8rem; font-weight: 700;">
              <%= (currentUser.full_name || currentUser.username).charAt(0).toUpperCase() %>
            </div>
            <div class="text-start d-none d-sm-block">
              <span class="fw-semibold d-block lh-1 text-dark" style="font-size: 0.85rem;"><%= currentUser.full_name || currentUser.username %></span>
              <span class="text-muted" style="font-size: 0.72rem;"><%= currentUser.role_name || currentUser.role %></span>
            </div>
          </button>
          <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2" aria-labelledby="userMenuBtn" style="min-width: 200px;">
            <li class="px-3 py-2 border-bottom">
              <div class="fw-bold text-dark"><%= currentUser.full_name %></div>
              <div class="text-muted small"><%= currentUser.email %></div>
              <span class="badge bg-primary-subtle text-primary border mt-1"><%= currentUser.role_name || currentUser.role %></span>
            </li>
            <li><a class="dropdown-item py-2" href="/profile"><i class="bi bi-person me-2"></i>My Profile & Password</a></li>
            <li><hr class="dropdown-divider my-1"></li>
            <li>
              <form action="/auth/logout" method="POST" class="m-0">
                <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
                <button type="submit" class="dropdown-item text-danger py-2">
                  <i class="bi bi-box-arrow-right me-2"></i>Sign Out
                </button>
              </form>
            </li>
          </ul>
        </div>
      <% } %>
    </div>
  </div>
</nav>
