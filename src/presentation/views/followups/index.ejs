<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
  <div>
    <h3 class="fw-bold mb-1">Follow-Up Management</h3>
    <p class="text-muted small mb-0">Schedule reminders, calls, meetings, demos, and track client interactions.</p>
  </div>
  <div>
    <a href="/followups/new" class="btn btn-primary shadow-sm fw-semibold">
      <i class="bi bi-calendar-plus-fill me-1"></i> Schedule Follow-Up
    </a>
  </div>
</div>

<!-- Filter Tabs -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
  <div class="card-body p-3">
    <div class="d-flex flex-wrap gap-2 mb-3">
      <a href="/followups" class="btn btn-sm <%= !filterRange ? 'btn-primary' : 'btn-outline-secondary' %>">All Follow-Ups</a>
      <a href="/followups?filterRange=overdue" class="btn btn-sm <%= filterRange === 'overdue' ? 'btn-danger' : 'btn-outline-danger' %>">
        <i class="bi bi-exclamation-triangle-fill me-1"></i> Overdue
      </a>
      <a href="/followups?filterRange=today" class="btn btn-sm <%= filterRange === 'today' ? 'btn-warning text-dark' : 'btn-outline-warning text-dark' %>">
        <i class="bi bi-clock me-1"></i> Today
      </a>
      <a href="/followups?filterRange=upcoming" class="btn btn-sm <%= filterRange === 'upcoming' ? 'btn-success' : 'btn-outline-success' %>">
        <i class="bi bi-calendar-check me-1"></i> Upcoming
      </a>
      <a href="/followups?status=Completed" class="btn btn-sm <%= status === 'Completed' ? 'btn-secondary' : 'btn-outline-secondary' %>">
        <i class="bi bi-check2-all me-1"></i> Completed
      </a>
    </div>

    <!-- Search Form -->
    <form action="/followups" method="GET" class="row g-2 align-items-center">
      <input type="hidden" name="filterRange" value="<%= filterRange %>">
      <div class="col-md-5">
        <input type="text" name="search" class="form-control" placeholder="Search subject..." value="<%= search %>">
      </div>
      <div class="col-md-3">
        <select name="type" class="form-select">
          <option value="">All Types</option>
          <option value="Call" <%= type === 'Call' ? 'selected' : '' %>>Call</option>
          <option value="Email" <%= type === 'Email' ? 'selected' : '' %>>Email</option>
          <option value="Meeting" <%= type === 'Meeting' ? 'selected' : '' %>>Meeting</option>
          <option value="Demo" <%= type === 'Demo' ? 'selected' : '' %>>Demo</option>
          <option value="Task" <%= type === 'Task' ? 'selected' : '' %>>Task</option>
        </select>
      </div>
      <div class="col-md-2">
        <button type="submit" class="btn btn-secondary w-100 fw-semibold">Filter</button>
      </div>
      <% if (search || type || filterRange) { %>
        <div class="col-md-2 text-end">
          <a href="/followups" class="btn btn-link text-muted p-0 small">Clear All</a>
        </div>
      <% } %>
    </form>
  </div>
</div>

<!-- Follow-Ups Table -->
<div class="card border-0 shadow-sm rounded-3 overflow-hidden">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead>
        <tr>
          <th>Subject</th>
          <th>Linked Entity</th>
          <th>Type</th>
          <th>Due Date</th>
          <th>Status</th>
          <th>Assigned To</th>
          <th class="text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (followUps.length === 0) { %>
          <tr>
            <td colspan="7" class="text-center py-5 text-muted">
              <i class="bi bi-calendar-check display-6 d-block mb-2 text-secondary opacity-50"></i>
              No follow-ups found matching criteria.
            </td>
          </tr>
        <% } %>
        <% const todayStr = new Date().toISOString().split('T')[0]; %>
        <% followUps.forEach(f => { %>
          <% const isOverdue = f.status === 'Planned' && f.follow_up_date < todayStr; %>
          <tr class="<%= isOverdue ? 'table-danger table-opacity-10' : '' %>">
            <td>
              <div class="fw-bold"><%= f.subject %></div>
              <% if (f.notes) { %>
                <small class="text-muted"><%= f.notes %></small>
              <% } %>
            </td>
            <td>
              <span class="badge bg-light text-dark border"><%= f.entity_type %> #<%= f.entity_id %></span>
            </td>
            <td>
              <span class="badge bg-info-subtle text-info border"><%= f.type %></span>
            </td>
            <td>
              <span class="<%= isOverdue ? 'text-danger fw-bold' : '' %>">
                <i class="bi <%= isOverdue ? 'bi-exclamation-circle-fill text-danger' : 'bi-calendar' %> me-1"></i>
                <%= f.follow_up_date %>
              </span>
            </td>
            <td>
              <% if (f.status === 'Completed') { %>
                <span class="badge bg-success-subtle text-success border badge-status">Completed</span>
              <% } else if (f.status === 'Missed') { %>
                <span class="badge bg-danger-subtle text-danger border badge-status">Missed</span>
              <% } else if (f.status === 'Cancelled') { %>
                <span class="badge bg-secondary-subtle text-secondary border badge-status">Cancelled</span>
              <% } else { %>
                <span class="badge bg-warning-subtle text-warning border badge-status">Planned</span>
              <% } %>
            </td>
            <td>
              <span class="small fw-semibold"><%= f.assigned_name %></span>
            </td>
            <td class="text-end">
              <div class="btn-group btn-group-sm">
                <% if (f.status === 'Planned') { %>
                  <form action="/followups/<%= f.id %>/complete" method="POST" class="d-inline m-0">
                    <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
                    <button type="submit" class="btn btn-outline-success" title="Mark Completed">
                      <i class="bi bi-check-lg"></i>
                    </button>
                  </form>
                  <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#rescheduleModal<%= f.id %>" title="Reschedule">
                    <i class="bi bi-arrow-clockwise"></i>
                  </button>
                <% } %>
                <% const role = currentUser.role_name || currentUser.role; %>
                <% if (role === 'Admin' || role === 'Manager') { %>
                  <form action="/followups/<%= f.id %>/delete" method="POST" class="d-inline confirm-action" data-confirm-message="Are you sure you want to delete this follow-up?">
                    <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
                    <button type="submit" class="btn btn-outline-danger" title="Delete">
                      <i class="bi bi-trash"></i>
                    </button>
                  </form>
                <% } %>
              </div>

              <!-- Reschedule Modal -->
              <div class="modal fade text-start" id="rescheduleModal<%= f.id %>" tabindex="-1">
                <div class="modal-dialog">
                  <div class="modal-content">
                    <form action="/followups/<%= f.id %>/reschedule" method="POST">
                      <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
                      <div class="modal-header">
                        <h6 class="modal-title fw-bold">Reschedule Follow-Up</h6>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                      </div>
                      <div class="modal-body">
                        <div class="mb-3">
                          <label class="form-label small fw-semibold">Subject</label>
                          <input type="text" class="form-control bg-light" value="<%= f.subject %>" readonly>
                        </div>
                        <div class="mb-3">
                          <label class="form-label small fw-semibold">New Due Date</label>
                          <input type="date" name="newDate" class="form-control" min="<%= todayStr %>" required>
                        </div>
                        <div class="mb-3">
                          <label class="form-label small fw-semibold">Rescheduling Reason / Notes</label>
                          <textarea name="notes" class="form-control" rows="2" placeholder="Reason for rescheduling..."></textarea>
                        </div>
                      </div>
                      <div class="modal-footer">
                        <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Update Schedule</button>
                      </div>
                    </form>
                  </div>
                </div>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <!-- Pagination -->
  <% if (pagination.totalPages > 1) { %>
    <div class="card-footer bg-white border-top py-3 d-flex justify-content-between align-items-center">
      <span class="small text-muted">Showing <%= followUps.length %> of <%= pagination.total %> records</span>
      <nav>
        <ul class="pagination pagination-sm mb-0">
          <li class="page-item <%= pagination.page <= 1 ? 'disabled' : '' %>">
            <a class="page-link" href="/followups?page=<%= pagination.page - 1 %>&filterRange=<%= filterRange %>">Previous</a>
          </li>
          <% for(let p = 1; p <= pagination.totalPages; p++) { %>
            <li class="page-item <%= pagination.page === p ? 'active' : '' %>">
              <a class="page-link" href="/followups?page=<%= p %>&filterRange=<%= filterRange %>"><%= p %></a>
            </li>
          <% } %>
          <li class="page-item <%= pagination.page >= pagination.totalPages ? 'disabled' : '' %>">
            <a class="page-link" href="/followups?page=<%= pagination.page + 1 %>&filterRange=<%= filterRange %>">Next</a>
          </li>
        </ul>
      </nav>
    </div>
  <% } %>
</div>
