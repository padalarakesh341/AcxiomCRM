<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
  <div>
    <h3 class="fw-bold mb-1">Security & Business Activity Audit Log</h3>
    <p class="text-muted small mb-0">Immutable, append-oriented audit records tracking authentication, administrative changes, and CRM events.</p>
  </div>
  <div>
    <a href="/reports/export/audit" class="btn btn-outline-secondary shadow-sm">
      <i class="bi bi-download me-1"></i> Export Audit CSV
    </a>
  </div>
</div>

<!-- Filters Card -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
  <div class="card-body p-3">
    <form action="/audit" method="GET" class="row g-2 align-items-center">
      <div class="col-md-3">
        <select name="module" class="form-select">
          <option value="">All Modules</option>
          <option value="AUTH" <%= filters.module === 'AUTH' ? 'selected' : '' %>>AUTH</option>
          <option value="CUSTOMER" <%= filters.module === 'CUSTOMER' ? 'selected' : '' %>>CUSTOMER</option>
          <option value="LEAD" <%= filters.module === 'LEAD' ? 'selected' : '' %>>LEAD</option>
          <option value="OPPORTUNITY" <%= filters.module === 'OPPORTUNITY' ? 'selected' : '' %>>OPPORTUNITY</option>
          <option value="FOLLOW_UP" <%= filters.module === 'FOLLOW_UP' ? 'selected' : '' %>>FOLLOW_UP</option>
          <option value="USER" <%= filters.module === 'USER' ? 'selected' : '' %>>USER</option>
        </select>
      </div>
      <div class="col-md-3">
        <select name="userId" class="form-select">
          <option value="">All Users</option>
          <% users.forEach(u => { %>
            <option value="<%= u.id %>" <%= String(filters.userId) === String(u.id) ? 'selected' : '' %>><%= u.full_name %> (@<%= u.username %>)</option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-2">
        <select name="result" class="form-select">
          <option value="">All Results</option>
          <option value="SUCCESS" <%= filters.result === 'SUCCESS' ? 'selected' : '' %>>SUCCESS</option>
          <option value="FAILURE" <%= filters.result === 'FAILURE' ? 'selected' : '' %>>FAILURE</option>
        </select>
      </div>
      <div class="col-md-2">
        <input type="date" name="startDate" class="form-control" value="<%= filters.startDate %>" title="Start Date">
      </div>
      <div class="col-md-2">
        <button type="submit" class="btn btn-secondary w-100 fw-semibold">Filter</button>
      </div>
    </form>
  </div>
</div>

<!-- Audit Trail Table -->
<div class="card border-0 shadow-sm rounded-3 overflow-hidden">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead>
        <tr>
          <th>Timestamp</th>
          <th>User</th>
          <th>Role</th>
          <th>Module</th>
          <th>Action</th>
          <th>Record ID</th>
          <th>Result</th>
          <th>Details</th>
          <th>IP Address</th>
        </tr>
      </thead>
      <tbody>
        <% if (logs.length === 0) { %>
          <tr><td colspan="9" class="text-center py-4 text-muted">No audit log records found matching query.</td></tr>
        <% } %>
        <% logs.forEach(log => { %>
          <tr>
            <td class="small text-muted"><%= log.created_at %></td>
            <td class="fw-semibold"><%= log.username || 'System' %></td>
            <td><span class="badge bg-light text-dark border"><%= log.role || 'System' %></span></td>
            <td><span class="badge bg-primary-subtle text-primary border"><%= log.module %></span></td>
            <td><code><%= log.action %></code></td>
            <td class="small text-muted"><%= log.record_id || '-' %></td>
            <td>
              <span class="badge <%= log.result === 'SUCCESS' ? 'bg-success' : 'bg-danger' %>"><%= log.result %></span>
            </td>
            <td class="small text-muted" style="max-width: 280px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="<%= log.details %>">
              <%= log.details || '-' %>
            </td>
            <td class="small text-muted"><%= log.ip_address %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <!-- Pagination -->
  <% if (pagination.totalPages > 1) { %>
    <div class="card-footer bg-white border-top py-3 d-flex justify-content-between align-items-center">
      <span class="small text-muted">Showing <%= logs.length %> of <%= pagination.total %> audit events</span>
      <nav>
        <ul class="pagination pagination-sm mb-0">
          <li class="page-item <%= pagination.page <= 1 ? 'disabled' : '' %>">
            <a class="page-link" href="/audit?page=<%= pagination.page - 1 %>&module=<%= filters.module %>&userId=<%= filters.userId %>">Previous</a>
          </li>
          <% for(let p = 1; p <= pagination.totalPages; p++) { %>
            <li class="page-item <%= pagination.page === p ? 'active' : '' %>">
              <a class="page-link" href="/audit?page=<%= p %>&module=<%= filters.module %>&userId=<%= filters.userId %>"><%= p %></a>
            </li>
          <% } %>
          <li class="page-item <%= pagination.page >= pagination.totalPages ? 'disabled' : '' %>">
            <a class="page-link" href="/audit?page=<%= pagination.page + 1 %>&module=<%= filters.module %>&userId=<%= filters.userId %>">Next</a>
          </li>
        </ul>
      </nav>
    </div>
  <% } %>
</div>
