{
  "openapi": "3.0.0",
  "info": {
    "title": "AcxiomCRM REST API",
    "version": "1.0.0",
    "description": "Secure, enterprise-grade RESTful API for AcxiomCRM covering Authentication, Customers, Leads, Opportunities, Follow-Ups, and Reporting."
  },
  "servers": [
    {
      "url": "/api/v1",
      "description": "API Version 1"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "required": ["identifier", "password"],
        "properties": {
          "identifier": { "type": "string", "example": "admin@acxiom.com" },
          "password": { "type": "string", "example": "Admin@12345" }
        }
      },
      "Customer": {
        "type": "object",
        "required": ["name", "email", "phone"],
        "properties": {
          "name": { "type": "string", "example": "Acme Global Corp" },
          "email": { "type": "string", "format": "email", "example": "contact@acmeglobal.com" },
          "phone": { "type": "string", "example": "+1-555-0199" },
          "company": { "type": "string", "example": "Acme Global" },
          "address": { "type": "string", "example": "100 Tech Way, Suite 400" },
          "status": { "type": "string", "enum": ["Active", "Inactive", "Lead"], "example": "Active" },
          "assignedUserId": { "type": "integer", "example": 3 },
          "notes": { "type": "string", "example": "Enterprise prospect." }
        }
      },
      "Lead": {
        "type": "object",
        "required": ["title", "contactPerson", "email", "phone"],
        "properties": {
          "title": { "type": "string", "example": "Cloud Migration RFP" },
          "contactPerson": { "type": "string", "example": "Sarah Connor" },
          "email": { "type": "string", "format": "email", "example": "s.connor@cyberdyne.io" },
          "phone": { "type": "string", "example": "+1-555-0812" },
          "company": { "type": "string", "example": "Cyberdyne Systems" },
          "source": { "type": "string", "enum": ["Website", "Referral", "Cold Call", "Campaign", "Partner", "Other"], "example": "Website" },
          "status": { "type": "string", "enum": ["New", "Contacted", "Qualified", "Unqualified", "Converted", "Lost"], "example": "New" },
          "priority": { "type": "string", "enum": ["Low", "Medium", "High"], "example": "High" },
          "assignedUserId": { "type": "integer", "example": 3 },
          "notes": { "type": "string", "example": "Looking for Q4 rollout." }
        }
      },
      "Opportunity": {
        "type": "object",
        "required": ["name", "customerId", "amount", "probability", "expectedCloseDate"],
        "properties": {
          "name": { "type": "string", "example": "Enterprise SaaS 200 Licenses" },
          "customerId": { "type": "integer", "example": 1 },
          "stage": { "type": "string", "enum": ["Qualification", "Proposal", "Negotiation", "Won", "Lost"], "example": "Proposal" },
          "amount": { "type": "number", "example": 45000.00 },
          "probability": { "type": "integer", "minimum": 0, "maximum": 100, "example": 70 },
          "expectedCloseDate": { "type": "string", "format": "date", "example": "2026-11-30" },
          "source": { "type": "string", "example": "Website" },
          "notes": { "type": "string", "example": "Negotiating pricing terms." }
        }
      },
      "FollowUp": {
        "type": "object",
        "required": ["subject", "entityType", "entityId", "followUpDate"],
        "properties": {
          "subject": { "type": "string", "example": "Quarterly Solution Demo" },
          "entityType": { "type": "string", "enum": ["Customer", "Lead", "Opportunity"], "example": "Lead" },
          "entityId": { "type": "integer", "example": 1 },
          "followUpDate": { "type": "string", "format": "date", "example": "2026-10-15" },
          "type": { "type": "string", "enum": ["Call", "Email", "Meeting", "Demo", "Task"], "example": "Demo" },
          "status": { "type": "string", "enum": ["Planned", "Completed", "Missed", "Cancelled"], "example": "Planned" },
          "notes": { "type": "string", "example": "Prepare deck for CTO." },
          "assignedUserId": { "type": "integer", "example": 3 }
        }
      }
    }
  },
  "paths": {
    "/auth/login": {
      "post": {
        "summary": "Authenticate user and get JWT token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" }
            }
          }
        },
        "responses": {
          "200": { "description": "Login successful" },
          "401": { "description": "Invalid credentials" },
          "403": { "description": "Account locked or deactivated" }
        }
      }
    },
    "/auth/me": {
      "get": {
        "summary": "Get authenticated user profile",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "Current user profile" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/customers": {
      "get": {
        "summary": "List customer records",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "search", "in": "query", "schema": { "type": "string" } },
          { "name": "status", "in": "query", "schema": { "type": "string" } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 10 } }
        ],
        "responses": { "200": { "description": "Paginated list of customers" } }
      },
      "post": {
        "summary": "Create customer record",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Customer" } } }
        },
        "responses": {
          "201": { "description": "Customer created" },
          "400": { "description": "Validation failed" }
        }
      }
    },
    "/customers/{id}": {
      "get": {
        "summary": "Get customer by ID with history and activities",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "Customer details" }, "404": { "description": "Not found" } }
      },
      "put": {
        "summary": "Update customer",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Customer" } } } },
        "responses": { "200": { "description": "Customer updated" } }
      },
      "delete": {
        "summary": "Delete customer (Admin/Manager only)",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "Customer deleted" }, "403": { "description": "Forbidden" } }
      }
    },
    "/leads": {
      "get": {
        "summary": "List leads",
        "security": [{ "BearerAuth": [] }],
        "responses": { "200": { "description": "List of leads" } }
      },
      "post": {
        "summary": "Create lead",
        "security": [{ "BearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Lead" } } } },
        "responses": { "201": { "description": "Lead created" } }
      }
    },
    "/leads/{id}/convert": {
      "post": {
        "summary": "Convert qualified lead into Customer and Opportunity",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "Converted successfully" }, "400": { "description": "Cannot convert" } }
      }
    },
    "/opportunities": {
      "get": {
        "summary": "List opportunities",
        "security": [{ "BearerAuth": [] }],
        "responses": { "200": { "description": "List of opportunities" } }
      },
      "post": {
        "summary": "Create opportunity",
        "security": [{ "BearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Opportunity" } } } },
        "responses": { "201": { "description": "Opportunity created" } }
      }
    },
    "/follow-ups": {
      "get": {
        "summary": "List follow-ups",
        "security": [{ "BearerAuth": [] }],
        "responses": { "200": { "description": "List of follow-ups" } }
      },
      "post": {
        "summary": "Schedule follow-up",
        "security": [{ "BearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FollowUp" } } } },
        "responses": { "201": { "description": "Follow-up created" } }
      }
    },
    "/reports/pipeline": {
      "get": {
        "summary": "Get sales pipeline stage & owner metrics",
        "security": [{ "BearerAuth": [] }],
        "responses": { "200": { "description": "Pipeline summary data" } }
      }
    },
    "/reports/conversion": {
      "get": {
        "summary": "Get lead conversion & win/loss ratio metrics",
        "security": [{ "BearerAuth": [] }],
        "responses": { "200": { "description": "Conversion metrics data" } }
      }
    }
  }
}
